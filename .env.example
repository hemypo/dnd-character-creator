# ========================================================
# D&D 2024 Character Sheet Generator - Environment Config
# ========================================================

# [Optional] OpenRouter API Configuration for AI Text Generation (Balance & Backstory)
# When unset or if API fails, the system automatically uses built-in high-quality
# deterministic offline rules engines and lore generators with zero credit consumption.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=google/gemma-4-31b-it:free
# Alternative free models on OpenRouter:
# OPENROUTER_TEXT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_TEXT_MODEL=openrouter/free

# [Optional] Google Gemini API Key (Alternative for text generation & vision)
GEMINI_API_KEY=

# [Optional] SubNP Free Image Generation API for Fantasy Portraits (Flux model)
# Documentation: https://subnp.com/ru/free-api
# Works out of the box with model "flux". If unreachable, falls back to dynamic SVG avatars.
SUBNP_API_URL=https://subnp.com/api/free/generate

# [Optional] Local JSON File Storage Directory
# Defaults to './data' in the project root.
DATA_DIR=./data

# [Optional] Server Port & Host (Default: 3000)
PORT=3000
NODE_ENV=development
